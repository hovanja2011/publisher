cabal-version:      3.0
name:               telegram-publisher
version:            0.1.0.0
build-type:         Simple

executable telegram-publisher
    main-is:          Main.hs
    hs-source-dirs:   app, src
    default-language: Haskell2010
    build-depends:
        base >= 4.14 && < 5,
        aeson,
        bytestring,
        http-client,
        http-client-tls
    ghc-options:      -Wall
